From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opsero <support@opsero.com>
Date: Mon, 28 Sep 2026 00:00:00 +0000
Subject: [PATCH] net: axienet: poll MRMAC block-lock and drive netdev carrier

The MRMAC has no PHY/phylink and gives no link-change interrupt, so the
stock driver only checks RX block lock once in axienet_open() with a 1 ms
timeout and fails the open (-ENODEV) if the link is not already up. On a
cold bring-up the GT/PCS need tens to hundreds of ms to lock, so the open
loses the race and the interface needs a manual "ip link" bounce; if the
link partner powers on after us, it never comes up at all.

Add a delayed work that drives the netdev carrier from RX block lock, RX
status and (10G/25G) a recent valid control code. open() now brings the
interface up with carrier off and starts the monitor instead of failing;
the work is cancelled in axienet_stop() and the open error path.

The status bits are latched (block lock and RX status latch low, the
valid control code flag latches high). Clearing and reading back-to-back
can return the value latched before the clear took effect, i.e. any drop
since the previous poll - including the drop caused by the monitor's own
reset, which then keeps the link "down" for good. Clear, wait 1-2 ms,
then read.

Only act after 3 consecutive bad samples (200 ms apart), so a transient
does not reset a working link. While down, recover with the same reset
sequence as open(): MRMAC reset, GT rate + TX/RX datapath reset (the
one-time GT reset/PLL setup is skipped), MRMAC reset. An MRMAC core/serdes
reset alone does not make the Versal GTY RX re-acquire block lock.

Log the raw RX status (0x744), block lock (0x754) and valid control code
(0x7B8) values on link down, and while down after 1, 2, 4, 8, ... recovery
resets; the link-up message reports how many recovery resets it took.

diff --git a/drivers/net/ethernet/xilinx/xilinx_axienet.h b/drivers/net/ethernet/xilinx/xilinx_axienet.h
index 054c5a3e1646..9fcaeab1c8e0 100644
--- a/drivers/net/ethernet/xilinx/xilinx_axienet.h
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet.h
@@ -1070,6 +1070,9 @@ struct axienet_local {
 	seqcount_mutex_t hw_stats_seqcount;
 	struct mutex stats_lock;
 	struct delayed_work stats_work;
+	struct delayed_work mrmac_link_work;
+	unsigned int mrmac_link_bad;
+	unsigned int mrmac_link_resets;
 	bool reset_in_progress;
 
 	bool stopping;
diff --git a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
index 51489c5426cf..6dfa4a4fbfdd 100644
--- a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
@@ -1058,6 +1058,120 @@ static inline int axienet_mrmac_gt_reset(struct net_device *ndev)
 	return 0;
 }
 
+/* MRMAC carrier monitor.
+ *
+ * The MRMAC has no PHY/phylink and no link-change interrupt, and the stock
+ * driver checks RX block lock only once in axienet_open(), failing the open
+ * if the GT/PCS has not locked yet and never retrying. Instead, poll the link
+ * from a work item and drive the netdev carrier from it.
+ *
+ * Block lock (0x754) and RX status (0x744 bit 0) latch low, the valid
+ * control code flag (0x7B8) latches high. Reading right after the clear can
+ * return the value latched before the clear took effect, i.e. any drop since
+ * the previous poll, including the one caused by our own reset (which then
+ * keeps the link "down" forever). So clear, let the core re-latch the live
+ * state, then read.
+ *
+ * One bad sample is not acted on: carrier goes off only after
+ * MRMAC_LINK_DOWN_SAMPLES consecutive bad samples. While down, recover with
+ * the MRMAC + GT datapath reset sequence of open() (minus the one-time GT
+ * reset/PLL setup); an MRMAC core/serdes reset alone does not make the GT RX
+ * re-acquire lock.
+ *
+ * Runs on the system workqueue (process context; the GT reset path sleeps in
+ * the *_cansleep GPIO accessors). Serialised against open/stop by
+ * cancel_delayed_work_sync() in axienet_stop() and the open error path.
+ */
+#define MRMAC_LINK_POLL_MS	1000
+#define MRMAC_LINK_RECHECK_MS	200
+#define MRMAC_LINK_RETRY_MS	500
+#define MRMAC_LINK_DOWN_SAMPLES	3
+
+static bool axienet_mrmac_link_sample(struct axienet_local *lp, u32 *rx_sts,
+				      u32 *blk_lck, u32 *vld_ctrl)
+{
+	bool ok;
+
+	axienet_iow(lp, MRMAC_STATRX_BLKLCK_OFFSET, MRMAC_STS_ALL_MASK);
+	axienet_iow(lp, MRMAC_RX_STS_OFFSET, MRMAC_STS_ALL_MASK);
+	axienet_iow(lp, MRMAC_STATRX_VALID_CTRL_OFFSET, MRMAC_STS_ALL_MASK);
+	usleep_range(1000, 2000);
+
+	*blk_lck = axienet_ior(lp, MRMAC_STATRX_BLKLCK_OFFSET);
+	*rx_sts = axienet_ior(lp, MRMAC_RX_STS_OFFSET);
+	*vld_ctrl = axienet_ior(lp, MRMAC_STATRX_VALID_CTRL_OFFSET);
+
+	ok = (*blk_lck & MRMAC_RX_BLKLCK_MASK) &&
+	     (*rx_sts & MRMAC_RX_STATUS_MASK);
+
+	/* 10G/25G MRMAC can mis-report RX status as good; also require a
+	 * recent valid control code, as the stock axienet_open() check does.
+	 */
+	if (lp->max_speed == SPEED_10000 || lp->max_speed == SPEED_25000)
+		ok = ok && (*vld_ctrl & MRMAC_RX_VALID_MASK);
+
+	return ok;
+}
+
+static void axienet_mrmac_recover(struct axienet_local *lp)
+{
+	int ret;
+
+	/* Same order as open(): MRMAC reset, GT rate + TX/RX datapath reset,
+	 * MRMAC reset again with the GT running.
+	 */
+	axienet_mrmac_reset(lp);
+	ret = axienet_mrmac_gt_reset(lp->ndev);
+	if (ret)
+		netdev_warn(lp->ndev, "MRMAC GT reset failed: %d\n", ret);
+	axienet_mrmac_reset(lp);
+	axienet_iow(lp, MRMAC_TICK_OFFSET, MRMAC_TICK_TRIGGER);
+	lp->mrmac_link_resets++;
+}
+
+static void axienet_mrmac_link_poll(struct work_struct *work)
+{
+	struct axienet_local *lp = container_of(work, struct axienet_local,
+						mrmac_link_work.work);
+	struct net_device *ndev = lp->ndev;
+	u32 rx_sts, blk_lck, vld_ctrl;
+	unsigned int delay_ms;
+
+	if (axienet_mrmac_link_sample(lp, &rx_sts, &blk_lck, &vld_ctrl)) {
+		lp->mrmac_link_bad = 0;
+		if (!netif_carrier_ok(ndev)) {
+			netif_carrier_on(ndev);
+			netdev_info(ndev, "MRMAC link up at %d (%u recovery resets)\n",
+				    lp->max_speed, lp->mrmac_link_resets);
+			lp->mrmac_link_resets = 0;
+		}
+		delay_ms = MRMAC_LINK_POLL_MS;
+		goto out;
+	}
+
+	if (netif_carrier_ok(ndev)) {
+		if (++lp->mrmac_link_bad < MRMAC_LINK_DOWN_SAMPLES) {
+			netdev_dbg(ndev, "MRMAC bad link sample %u (rx_sts 0x%x blk_lck 0x%x vld_ctrl 0x%x)\n",
+				   lp->mrmac_link_bad, rx_sts, blk_lck, vld_ctrl);
+			delay_ms = MRMAC_LINK_RECHECK_MS;
+			goto out;
+		}
+		netif_carrier_off(ndev);
+		if (net_ratelimit())
+			netdev_warn(ndev, "MRMAC link down (rx_sts 0x%x blk_lck 0x%x vld_ctrl 0x%x)\n",
+				    rx_sts, blk_lck, vld_ctrl);
+	} else if (lp->mrmac_link_resets &&
+		   is_power_of_2(lp->mrmac_link_resets)) {
+		netdev_info(ndev, "MRMAC link still down after %u recovery resets (rx_sts 0x%x blk_lck 0x%x vld_ctrl 0x%x)\n",
+			    lp->mrmac_link_resets, rx_sts, blk_lck, vld_ctrl);
+	}
+
+	axienet_mrmac_recover(lp);
+	delay_ms = MRMAC_LINK_RETRY_MS;
+out:
+	schedule_delayed_work(&lp->mrmac_link_work, msecs_to_jiffies(delay_ms));
+}
+
 static inline int xxv_gt_reset(struct net_device *ndev)
 {
 	struct axienet_local *lp = netdev_priv(ndev);
@@ -3054,45 +3168,26 @@ static int axienet_open(struct net_device *ndev)
 	}
 
 	if (lp->axienet_config->mactype == XAXIENET_MRMAC) {
-		u32 val;
-
-		/* Reset MRMAC */
+		/* Reset MRMAC and let the GT/PCS settle. */
 		axienet_mrmac_reset(lp);
-
 		mdelay(DELAY_1MS * 100);
-		/* Check for block lock bit to be set. This ensures that
-		 * MRMAC ethernet IP is functioning normally.
-		 */
-		axienet_iow(lp, MRMAC_TX_STS_OFFSET, MRMAC_STS_ALL_MASK);
-		axienet_iow(lp, MRMAC_RX_STS_OFFSET, MRMAC_STS_ALL_MASK);
-		ret = readx_poll_timeout(axienet_get_mrmac_blocklock, lp, val,
-					 (val & MRMAC_RX_BLKLCK_MASK), 10, DELAY_OF_ONE_MILLISEC);
-		if (ret)
-			netdev_err(ndev, "MRMAC block lock not complete! Cross-check the MAC ref clock configuration\n");
 
-		ret = readx_poll_timeout(axienet_get_mrmac_rx_status, lp, val,
-					 (val & MRMAC_RX_STATUS_MASK), 10, DELAY_OF_ONE_MILLISEC);
-		if (ret) {
-			netdev_err(ndev, "MRMAC Link is down!\n");
-			ret = -ENODEV;
-			goto err_phy;
-		}
-
-		/* Distinguish a mis-reported status=good for 10G/25G MRMAC */
-		if (lp->max_speed == SPEED_10000 ||
-		    lp->max_speed == SPEED_25000) {
-			axienet_iow(lp, MRMAC_STATRX_VALID_CTRL_OFFSET, MRMAC_STS_ALL_MASK);
-			val = axienet_ior(lp, MRMAC_STATRX_VALID_CTRL_OFFSET);
-
-			if (!(val & MRMAC_RX_VALID_MASK)) {
-				netdev_err(ndev, "MRMAC Link is down! No recent RX Valid Control Code\n");
-				ret = -ENODEV;
-				goto err_phy;
-			}
-		}
-
-		netdev_info(ndev, "MRMAC setup at %d\n", lp->max_speed);
+		/* MRMAC has no PHY/phylink and no link-change interrupt. Rather
+		 * than fail open() with a one-shot block-lock check (which loses
+		 * the race on a cold bring-up and never retries), bring the
+		 * interface up with carrier off and let axienet_mrmac_link_poll()
+		 * raise/lower carrier from the RX block-lock + status, re-running
+		 * the MRMAC + GT datapath resets while down. The link then comes
+		 * up whenever both ends are lasing, including when the far end
+		 * powers on after us.
+		 */
 		axienet_iow(lp, MRMAC_TICK_OFFSET, MRMAC_TICK_TRIGGER);
+		netif_carrier_off(ndev);
+		lp->mrmac_link_bad = 0;
+		lp->mrmac_link_resets = 0;
+		schedule_delayed_work(&lp->mrmac_link_work, 0);
+		netdev_info(ndev, "MRMAC setup at %d (link monitored)\n",
+			    lp->max_speed);
 	}
 
 	/* If Runtime speed switching supported */
@@ -3135,6 +3230,8 @@ static int axienet_open(struct net_device *ndev)
 		free_irq(lp->eth_irq, ndev);
 err_phy:
 	cancel_delayed_work_sync(&lp->stats_work);
+	if (lp->axienet_config->mactype == XAXIENET_MRMAC)
+		cancel_delayed_work_sync(&lp->mrmac_link_work);
 	if (lp->phylink) {
 		phylink_stop(lp->phylink);
 		phylink_disconnect_phy(lp->phylink);
@@ -3161,6 +3258,8 @@ static int axienet_stop(struct net_device *ndev)
 		WRITE_ONCE(lp->stopping, true);
 
 	cancel_delayed_work_sync(&lp->stats_work);
+	if (lp->axienet_config->mactype == XAXIENET_MRMAC)
+		cancel_delayed_work_sync(&lp->mrmac_link_work);
 
 	if (lp->phylink) {
 		phylink_stop(lp->phylink);
@@ -5118,6 +5217,7 @@ static int axienet_probe(struct platform_device *pdev)
 	mutex_init(&lp->stats_lock);
 	seqcount_mutex_init(&lp->hw_stats_seqcount, &lp->stats_lock);
 	INIT_DEFERRABLE_WORK(&lp->stats_work, axienet_refresh_stats);
+	INIT_DELAYED_WORK(&lp->mrmac_link_work, axienet_mrmac_link_poll);
 	INIT_LIST_HEAD(&lp->rx_fs_list.list);
 
 	lp->axi_clk = devm_clk_get_optional(&pdev->dev, "s_axi_lite_clk");
